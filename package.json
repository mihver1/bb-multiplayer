{
  "name": "bb-plugin-multiplayer",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bb": ">=0.46.1",
    "bbPluginSdk": ">=0.6.49 <0.7"
  },
  "bb": {
    "name": "Multiplayer [Experimental]",
    "description": "Shared project conversations and contextual comments across independent BB installations.",
    "branding": {
      "icon": "./assets/people.svg",
      "experimental_icons": {
        "people": "./assets/people.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check server.ts host.ts app.tsx app.css shared plugin relay provider tests docs hooks/use-team-query.ts lib/register-thread-panel.ts lib/discussion-target.ts components/floating-discussion.tsx components/discussion-list.tsx components/icon-action.tsx components/team-thread-list.tsx components/project-header.tsx components/message-requests.tsx components/native-mirror.tsx vitest.config.ts",
    "relay:init": "tsx relay/main.ts init",
    "relay:start": "tsx relay/main.ts serve"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^5.0.5"
  }
}
